# Copy file nay thanh `.env` (cung thu muc voi requirements.txt) roi dien gia
# tri that. Moi bien deu co default an toan trong app/core/config.py neu bo
# trong o day - file nay chi liet ke day du de biet co gi co the cau hinh.

# --- Database (bat buoc MySQL) -------------------------------------------
# He thong CHI dung MySQL - khong con che do fallback ve SQLite. Dien du 5
# bien MYSQL_* ben duoi; neu ket noi that bai luc khoi dong, ung dung se bao
# loi va dung lai ngay (xem app/core/database.py). SQLite chi con duoc dung
# noi bo boi bo test tu dong (tests/conftest.py), khong lien quan cau hinh
# nay.
USE_MYSQL=true
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=recruitment_db

# --- JWT / Auth -----------------------------------------------------------
# BAT BUOC doi JWT_SECRET truoc khi deploy that - gia tri mac dinh trong
# code chi danh cho dev/test.
JWT_SECRET=change-me-in-production

# --- SMTP (gui email that, tuy chon) --------------------------------------
# Bo trong SMTP_USER/SMTP_PASSWORD -> he thong tu dong chay che do simulate
# (chi ghi audit_logs, khong gui that qua mang) - khong chan luong nghiep vu.
# Voi Gmail da bat 2FA, phai tao App Password rieng tai
# https://myaccount.google.com/apppasswords (mat khau dang nhap thuong se bi
# tu choi).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ATS v2 Recruitment
COMPANY_NAME=Cong ty Demo ATS

# --- AI Screening (phan tich CV, tuy chon) --------------------------------
# Bo trong AI_API_KEY -> POST /ai/analyze tra loi 400 voi thong bao ro rang
# (khong con che do stub/phan tich gia lap - da bo hoan toan, xem
# app/services/ai_service.py). AI_MODEL de trong se dung model mac dinh cua
# provider da chon (xem DEFAULT_MODELS trong ai_service.py).
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
